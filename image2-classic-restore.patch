+"""Image2 prompt mode for tests.
+
+The sectioned "strict" prompts are covered by the existing Image2 tests, so those
+modules run with IMAGE2_PROMPT_MODE=strict. The default ("classic") mode is covered
+by test_image2_classic_mode.py.
+"""
+import pytest
+
+STRICT_MODULES = {
+    "test_image2_multi_reference",
+    "test_image2_prompt_contract",
+    "test_image2_reference_roles",
+    "test_image2_scene_fidelity_generated",
+    "test_reference_mapping",
+}
+
+
+@pytest.fixture(autouse=True)
+def _image2_prompt_mode(request, monkeypatch):
+    if request.module.__name__.rsplit(".", 1)[-1] in STRICT_MODULES:
+        monkeypatch.setenv("IMAGE2_PROMPT_MODE", "strict")
+    else:
+        monkeypatch.delenv("IMAGE2_PROMPT_MODE", raising=False)
