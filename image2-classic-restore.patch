@@ -0,0 +1,46 @@
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from catalog import MODEL_CATALOG, text_to_image_images, openai_legacy_text_to_image_input  # noqa: E402
+from prompts import add_image_reference_map, build_feature_prompt  # noqa: E402
+
+
+def _fields(**extra):
+    base = {"feature": "text_to_image", "option_id": "", "sceneDetails": "A sunlit loft with @img1 on the left"}
+    base.update(extra)
+    return base
+
+
+def test_classic_prompt_is_short_and_leaves_lighting_to_the_user():
+    prompt = build_feature_prompt("text_to_image", _fields(aspectRatio="16:9"))
+    assert "TASK:" not in prompt and "FIDELITY RULES" not in prompt and "OUTPUT FRAME" not in prompt
+    assert "Let the user's prompt decide the lighting and mood" in prompt
+
+
+def test_classic_reference_map_offsets_follow_provider_order():
+    fields = _fields(
+        styleReferenceUrl="s", imageUrl="e", referenceUrls=["a", "b"], referenceTags=["@img1", "@img2"],
+    )
+    mapped = add_image_reference_map("P", fields)
+    assert "input image 1 and is named @style" in mapped
+    assert "@element is content image 2" in mapped
+    assert "@img1 is content/reference image 3" in mapped
+    assert "@img2 is content/reference image 4" in mapped
+    assert text_to_image_images(fields) == ["s", "e", "a", "b"]
+
+
+def test_classic_reference_map_without_style_or_primary_starts_at_one():
+    mapped = add_image_reference_map("P", _fields(referenceUrls=["a"], referenceTags=["@img1"]))
+    assert "@img1 is content/reference image 1" in mapped
+
+
+def test_classic_models_are_selectable_and_use_native_openai_sizes():
+    keys = {c.key for c in MODEL_CATALOG["text_to_image"]}
+    assert {"gpt-image-1", "gemini-2.5-flash-image"} <= keys
+    payload = openai_legacy_text_to_image_input(
+        {"prompt": "p", "aspectRatio": "3:2", "quality": "standard", "quantity": 1, "imageUrl": "e"}
+    )
+    assert payload["size"] == "1536x1024" and payload["quality"] == "medium"
+    assert payload["output_format"] == "jpeg" and payload["images"] == ["e"]
